# Copia questo file in .env (che NON va mai committato) e adattalo.
# Questi valori vanno bene per lavorare sul proprio computer.

# Porta e indirizzo su cui ascolta l'app.
# In produzione l'app sta dietro nginx: HOST=127.0.0.1 (vedi docs/AMBIENTE.md).
PORT=3003
HOST=127.0.0.1

# Chi può entrare e con quale profilo: {"indirizzo IP": "Nome"}.
# - Ogni nome è un profilo del diario; più IP con lo stesso nome = la stessa persona.
# - Un IP che non è qui riceve 403.
# - In locale il browser arriva da 127.0.0.1 (o ::1): così entri come "Sviluppo".
# - Gli IP finti 10.99.0.N sono "persone di prova": con `npm run persone` ognuna
#   ha il suo indirizzo (http://127.0.0.1:3011 = Anna, :3012 = Bruno, :3013 = Carla).
KNOWN_IPS={"127.0.0.1":"Sviluppo","::1":"Sviluppo","10.99.0.1":"Anna","10.99.0.2":"Bruno","10.99.0.3":"Carla"}

# Cartella dei dati (file JSON, file caricati, backup). Default: ./data
# DATA_DIR=./data

# Solo per importare la vecchia clipboard da Redis (serve solo sul server, una volta).
# REDIS_URL=redis://default:PASSWORD@HOST:6379
